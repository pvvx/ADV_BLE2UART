menu "Board LED / RMT Configuration"

config LED_GPIO
    int "Regular LED GPIO number (0 = none)"
    default 0
    range 0 48
    help
        GPIO for a regular single-colour LED driven by PWM (LEDC).
        Set to 0 if no regular LED is present. Configured via --led <gpio>.

config LED_ACTIVE_LOW
    bool "Regular LED is active-low"
    depends on LED_GPIO != 0
    default y
    help
        Set if the regular LED is active-low (HIGH = OFF, LOW = ON).

config LED_IDLE_LEVEL
    int "Regular LED idle level"
    depends on LED_GPIO != 0
    default 1
    help
        Idle level for the regular LED. 1 = OFF (for active-low LED), 0 = ON.

config RGB_GPIO
    int "RGB LED (SK6812/WS2812) GPIO number (0 = none)"
    default 0
    range 0 48
    help
        GPIO for an SK6812/WS2812 addressable RGB LED driven via RMT.
        Set to 0 if no RGB LED is present. Configured via --rgb <gpio>.

config RGB_LED_ORDER_GRB
    bool "RGB LED uses GRB byte order (WS2812 standard)"
    depends on RGB_GPIO != 0
    default y
    help
        Most WS2812/SK6812 LEDs expect GRB byte order (Green, Red, Blue).
        Some boards (e.g. certain ESP32-S3 variants) use RGB order.
        Disable this if red and green appear swapped on your LED.

choice ADV_BLINK
    prompt "Advertisement blink target"
    default ADV_BLINK_LED if LED_GPIO != 0
    default ADV_BLINK_RGB if RGB_GPIO != 0
    default ADV_BLINK_NONE
    help
        Which LED blinks on received advertisements.
        Configured via --adv <led|rgb|none>.

config ADV_BLINK_LED
    bool "Regular LED"
    depends on LED_GPIO != 0

config ADV_BLINK_RGB
    bool "RGB LED"
    depends on RGB_GPIO != 0

config ADV_BLINK_NONE
    bool "None"
endchoice

config BOARD_LED_PULSE_US
    int "Activity pulse duration (μs)"
    default 25000
    range 1000 1000000
    help
        Duration of the activity pulse in microseconds.

config BOARD_HW_VERSION
    hex "Hardware version byte"
    default 0xC3
    range 0x00 0xFF
    help
        Hardware version reported in INFO responses.
        Auto-derived from the target chip name (e.g. 0xC3 for esp32c3).

endmenu

