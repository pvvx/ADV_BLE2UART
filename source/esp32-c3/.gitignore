# Local ESP-IDF toolchain + Python venv installed by ./install.sh
.tooling/

# Generic build artifacts: ignore the whole CMake/IDF tree under ble50_scan/build/
# except the three flashable binaries (the only outputs we ship).
ble50_scan/build/**
!ble50_scan/build/
!ble50_scan/build/ble50_scan.bin
!ble50_scan/build/bootloader/
!ble50_scan/build/bootloader/bootloader.bin
!ble50_scan/build/partition_table/
!ble50_scan/build/partition_table/partition-table.bin

# Python caches and editor scratch
__pycache__/
*.pyc
.vscode/

# Compiled executables (host x86-64 and cross-compiled MIPS)
ble50_scan/adv2uart
ble50_scan/adv2uart_tui
ble50_scan/*.mips

ble50_scan/esptool.exe
ble50_scan/build/
ble50_scan/sdkconfig
ble50_scan/sdkconfig.old
